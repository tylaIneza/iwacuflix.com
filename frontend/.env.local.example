NEXT_PUBLIC_API_URL=http://localhost:5000

# Public site URL — used for canonical links and Open Graph metadata.
# Set this to your real production domain when you deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Leave unset to keep AdSense disabled (e.g. in local dev).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-2800977850900039

# Ad unit slot IDs from the AdSense dashboard (Ads > By ad unit > Display ads).
# Each ad placement needs its own slot ID; leave unset to hide that placement.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_WATCH=
